# Mobile-Technologies React Native App Environment Variables
API_BASE_URL=http://localhost:8001/api
APP_NAME=Mobile-Technologies
APP_VERSION=1.0.0

# Backend Integration
BACKEND_URL=http://localhost:8001
API_TIMEOUT=30000

# Camera Settings
CAMERA_QUALITY=high
ID_CAPTURE_TIMEOUT=5000
BIOMETRIC_CAPTURE_TIMEOUT=10000

# Security
BIOMETRIC_STORAGE_ENABLED=true
SECURE_KEYCHAIN_SERVICE=com.mobiletechnologies.ekyc